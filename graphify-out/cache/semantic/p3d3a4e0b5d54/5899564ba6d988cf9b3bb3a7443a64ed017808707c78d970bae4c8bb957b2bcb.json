{"nodes": [{"id": "docs_features_abuse_limits", "label": "Feature: Abuse limits and server hygiene", "file_type": "document", "source_file": "docs/features/abuse-limits.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_features_abuse_limits_receiving_switch", "label": "Receiving switch (settings.receivingEnabled)", "file_type": "concept", "source_file": "docs/features/abuse-limits.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anyone on the same Wi-Fi can reach the server while Receive is open; a global switch stops advertising, hides the QR and answers untrusted offers with 403 receiving_off."}, {"id": "docs_features_abuse_limits_ratelimiter", "label": "RateLimiter (token bucket per remote IP)", "file_type": "code", "source_file": "docs/features/abuse-limits.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents a stranger flooding offers or auth; 1,024 tracked addresses with LRU eviction keeps memory bounded."}, {"id": "docs_features_abuse_limits_serverlimits", "label": "ServerLimits (header and body size limits)", "file_type": "code", "source_file": "docs/features/abuse-limits.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "dart:io only stops headers at 1 MB and cannot be configured, so the app enforces 16 KB headers and per-route body caps itself."}, {"id": "docs_features_abuse_limits_memory_caps", "label": "Server memory caps (challenges, tokens)", "file_type": "concept", "source_file": "docs/features/abuse-limits.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_features_abuse_limits_session_pruning", "label": "Session pruning (ReceiveServer.prune)", "file_type": "concept", "source_file": "docs/fea