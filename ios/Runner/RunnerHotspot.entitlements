<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runner.entitlements plus Hotspot Configuration (D-055), for builds signed
  with a paid Apple Developer Program account. Free Apple IDs cannot have
  this capability, so the default build uses Runner.entitlements. To use
  this file: Runner target > Build Settings > Code Signing Entitlements =
  Runner/RunnerHotspot.entitlements, or pass
  CODE_SIGN_ENTITLEMENTS=Runner/RunnerHotspot.entitlements to xcodebuild.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(APP_GROUP_ID)</string>
	</array>
	<key>com.apple.developer.networking.HotspotConfiguration</key>
	<true/>
</dict>
</plist>
